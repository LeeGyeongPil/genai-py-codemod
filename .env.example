# genai-py-codemod needs no API key: migration is static analysis and `verify` uses mocked transports.
# Both variables below are optional.

# Language of messages: en or ko. The --lang option overrides it; otherwise LC_ALL / LC_MESSAGES / LANG decide.
# GENAI_PY_CODEMOD_LANG=en

# Interpreter that has google-cloud-aiplatform 2.10.0 installed (create it with scripts/make_vertex_env.py).
# Only the cross-interpreter Vertex tests read it; they are skipped when it is unset.
# GENAI_PY_CODEMOD_VERTEX_PYTHON=.venv-vertex/bin/python
